# Copy to .env (same folder). Never commit real keys. All keys are optional:
# without them the API backends / YouTube features report "not configured" and nothing is faked.

# LLM API providers (billed per call; project budgets in Settings cap the spend)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# YouTube Data API v3 key for the Trend Research Engine (public data only)
YOUTUBE_API_KEY=

# Optional TTS provider (commercial voice licence depends on your plan)
ELEVENLABS_API_KEY=

# Optional overrides
# TIMELINES_PORT=8790
# TIMELINES_DATABASE_URL=postgresql+psycopg://user:pass@localhost/timelines   (default: SQLite in data/)
# TIMELINES_VIDEO_ROOT=<ultradedit>\research\timelines_videos   (must stay below ultradedit/research)
# BLENDER_EXE=C:\Program Files\Blender Foundation\Blender 5.1\blender.exe
# TIMELINES_ALLOW_UNCLEAR_LICENSES=1    (internal tests only: lets map renders use layers whose licence is unclear)
